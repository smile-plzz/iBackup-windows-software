<Page
    x:Class="iBackup.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:iBackup.App.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer MaxWidth="848" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel HorizontalAlignment="Stretch" Margin="24,32,24,32" Spacing="16">

            <!-- Title Header -->
            <StackPanel Spacing="8" Margin="0,0,0,12">
                <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Customize backup behavior, automation schedules, and media filters."
                           Style="{StaticResource SupportingTextStyle}" />
            </StackPanel>

            <!-- 1. Media Filters & Organization Card -->
            <Border Style="{StaticResource SurfaceCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Folder Organization &amp; Media Filters" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Choose how files are organized on disk and which media types to include."
                               Style="{StaticResource SupportingTextStyle}" FontSize="13" />

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <StackPanel Spacing="8">
                        <TextBlock Text="Folder Structure" FontWeight="Medium" />
                        <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedOrganizationIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" MinWidth="260">
                            <ComboBoxItem Content="By Year and Month (e.g. 2026 \ 11)" />
                            <ComboBoxItem Content="By Year, Month, and Day (e.g. 2026 \ 11 \ 03)" />
                            <ComboBoxItem Content="Flat (all files in device root folder)" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="10" Margin="0,8,0,0">
                        <TextBlock Text="Include Media Types" FontWeight="Medium" />
                        <Grid RowSpacing="10" ColumnSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Content="Photos (HEIC, JPG, PNG, GIF)"
                                      IsChecked="{x:Bind ViewModel.BackupPhotos, Mode=TwoWay}" />
                            <CheckBox Grid.Column="1" Content="Videos (MOV, MP4, ProRes, Slow-Mo)"
                                      IsChecked="{x:Bind ViewModel.BackupVideos, Mode=TwoWay}" />
                            <CheckBox Grid.Row="1" Content="Apple ProRAW (DNG)"
                                      IsChecked="{x:Bind ViewModel.BackupRaw, Mode=TwoWay}" />
                            <CheckBox Grid.Row="1" Grid.Column="1" Content="Screenshots"
                                      IsChecked="{x:Bind ViewModel.BackupScreenshots, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2. Scheduled Backups Card -->
            <Border Style="{StaticResource SurfaceCardStyle}">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Scheduled Automated Backups" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Automatically sync photos in the background on your schedule."
                                       Style="{StaticResource SupportingTextStyle}" FontSize="13" />
                        </StackPanel>

                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsScheduleEnabled, Mode=TwoWay}"
                                      OnContent="Active" OffContent="Off" VerticalAlignment="Center" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <StackPanel Spacing="14"
                                Visibility="{x:Bind ViewModel.IsScheduleEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Frequency" FontWeight="Medium" />
                                <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedScheduleFrequencyIndex, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Daily (Once every day)" />
                                    <ComboBoxItem Content="Weekly (Every Sunday)" />
                                    <ComboBoxItem Content="On Connect (Whenever iPhone is attached)" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Backup Time" FontWeight="Medium" />
                                <TimePicker Time="{x:Bind ViewModel.ScheduleTime, Mode=TwoWay}"
                                            ClockIdentifier="24HourClock" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Only backup when plugged into AC power (preserves laptop battery)"
                                  IsChecked="{x:Bind ViewModel.ScheduleOnlyOnAcPower, Mode=TwoWay}" />

                        <!-- Schedule Status Summary -->
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="12,8">
                            <TextBlock Text="{x:Bind ViewModel.ScheduleSummaryText, Mode=OneWay}"
                                       Style="{ThemeResource CaptionTextBlockStyle}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. System & Background Behavior Card -->
            <Border Style="{StaticResource SurfaceCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="System &amp; Background Behavior" FontSize="18" FontWeight="SemiBold" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Launch with Windows" FontWeight="Medium" />
                            <TextBlock Text="Start iBackup silently in the background when signing in."
                                       Style="{StaticResource SupportingTextStyle}" FontSize="13" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                                      OnContent="Yes" OffContent="No" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Minimize to System Tray" FontWeight="Medium" />
                            <TextBlock Text="Keep iBackup active in the notification area when closing window."
                                       Style="{StaticResource SupportingTextStyle}" FontSize="13" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}"
                                      OnContent="Yes" OffContent="No" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Verify Copy Integrity (SHA-256)" FontWeight="Medium" />
                            <TextBlock Text="Compute SHA-256 hash post-transfer to record in SQLite manifest."
                                       Style="{StaticResource SupportingTextStyle}" FontSize="13" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.VerifyIntegrity, Mode=TwoWay}"
                                      OnContent="Yes" OffContent="No" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Local Wi-Fi Companion Endpoint" FontWeight="Medium" />
                            <TextBlock Text="Enable local network listener for wireless camera roll backup."
                                       Style="{StaticResource SupportingTextStyle}" FontSize="13" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.EnableWirelessSync, Mode=TwoWay}"
                                      OnContent="Active" OffContent="Disabled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. About & Modern Branding Card -->
            <Border Style="{StaticResource SurfaceCardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Image Source="ms-appx:///Assets/iBackup-icon.png" Width="48" Height="48"
                               AutomationProperties.Name="iBackup icon" />
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="iBackup" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}"
                                       Style="{StaticResource SupportingTextStyle}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Your memories, on your own drive. Native, incremental, privacy-first."
                               Style="{StaticResource SupportingTextStyle}" />

                    <HyperlinkButton Content="Project &amp; Release Notes (GitHub)"
                                     NavigateUri="{x:Bind ViewModel.GitHubUrl, Mode=OneWay}" Padding="0,4" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
