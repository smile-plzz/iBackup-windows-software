<Page
    x:Class="iBackup.App.Views.WirelessPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:iBackup.App.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer MaxWidth="848" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel HorizontalAlignment="Stretch" Margin="24,32,24,32" Spacing="16">

            <!-- Title Header -->
            <StackPanel Spacing="8" Margin="0,0,0,12">
                <TextBlock Text="Wireless Sync" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Cable-free media backup over your local Wi-Fi."
                           Style="{StaticResource SupportingTextStyle}" />
            </StackPanel>

            <!-- 1. Active Wireless Server Card -->
            <Border Style="{StaticResource SurfaceCardStyle}">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10"
                                         Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                         Visibility="{x:Bind ViewModel.IsServerRunning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Ellipse Width="10" Height="10" Fill="#8A8886"
                                         Visibility="{x:Bind ViewModel.IsServerRunning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}" />
                                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontWeight="SemiBold" FontSize="18" />
                            </StackPanel>
                            <TextBlock Text="Fast, local-network transfer with zero cloud upload."
                                       Style="{StaticResource SupportingTextStyle}" FontSize="13" />
                        </StackPanel>

                        <Button Grid.Column="1" Command="{x:Bind ViewModel.ToggleServerCommand}"
                                VerticalAlignment="Center" Padding="14,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="14"
                                          Visibility="{x:Bind ViewModel.IsServerRunning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}" />
                                <FontIcon Glyph="&#xE769;" FontSize="14"
                                          Visibility="{x:Bind ViewModel.IsServerRunning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Text="Toggle Server" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!-- QR Code & Pairing PIN -->
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Minimalist QR Display Card -->
                        <Border Background="#FFFFFF" CornerRadius="12" Padding="14" Width="170" Height="170"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid>
                                <FontIcon Glyph="&#xED14;" FontSize="100" Foreground="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Text="Scan to Pair" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A"
                                           VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Pair with iPhone Camera" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="Open the Camera app on your iPhone and point it at the code to launch the wireless companion."
                                           Style="{StaticResource SupportingTextStyle}" FontSize="13" />
                            </StackPanel>

                            <!-- PIN Pill Badge -->
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="Pairing PIN:" Style="{StaticResource SupportingTextStyle}" VerticalAlignment="Center" />
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,4">
                                    <TextBlock Text="{x:Bind ViewModel.PairingPin, Mode=OneWay}"
                                               FontWeight="Bold" FontSize="16" FontFamily="Consolas, Segoe UI"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>

                            <!-- Quick Action Buttons -->
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Command="{x:Bind ViewModel.CopyUrlCommand}" Padding="14,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                        <TextBlock Text="Copy Link" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.OpenInBrowserCommand}" Padding="14,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE774;" FontSize="14" />
                                        <TextBlock Text="Open in Browser" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!-- Realtime activity status -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="12,10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE81C;" FontSize="16" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.RecentActivityText, Mode=OneWay}"
                                       VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 2. Apple Native Wi-Fi Sync Guide Card -->
            <Border Style="{StaticResource SurfaceCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Apple Native Wi-Fi Sync" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="You can also use Windows Portable Devices over Wi-Fi without opening the companion web page:"
                               Style="{StaticResource SupportingTextStyle}" />
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel Spacing="8">
                        <TextBlock Text="1. Connect your iPhone via USB once and tap Trust This Computer." FontWeight="Medium" />
                        <TextBlock Text="2. In the Apple Devices or iTunes app on your PC, check 'Sync with this iPhone over Wi-Fi'." FontWeight="Medium" />
                        <TextBlock Text="3. Keep both PC and iPhone on the same Wi-Fi network." FontWeight="Medium" />
                        <TextBlock Text="iBackup will automatically recognize the device wirelessly whenever it is nearby."
                                   Style="{StaticResource SupportingTextStyle}" FontSize="13" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

