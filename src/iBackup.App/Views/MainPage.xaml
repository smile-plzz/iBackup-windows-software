<Page
    x:Class="iBackup.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:iBackup.App.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer MaxWidth="848" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel HorizontalAlignment="Stretch" Margin="24,32,24,32" Spacing="16">

            <!-- Title Header -->
            <StackPanel Spacing="8" Margin="0,0,0,12">
                <TextBlock Text="Your memories. Kept close." Style="{StaticResource PageTitleStyle}" TextWrapping="Wrap" />
                <TextBlock Text="Local, incremental backup for iPhone and iPad media without cloud dependencies."
                           Style="{StaticResource SupportingTextStyle}" />
            </StackPanel>

            <InfoBar IsOpen="{x:Bind ViewModel.IsMessageOpen, Mode=TwoWay}"
                     Title="{x:Bind ViewModel.MessageTitle, Mode=OneWay}"
                     Message="{x:Bind ViewModel.MessageText, Mode=OneWay}"
                     Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
                     IsClosable="True" />

            <!-- 1. Device & Storage Breakdown Card -->
            <Border Style="{StaticResource SurfaceCardStyle}">
                <Grid>
                    <!-- Connected State -->
                    <StackPanel Spacing="16"
                                Visibility="{x:Bind ViewModel.IsDeviceConnected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Glyph="&#xE8EA;" FontSize="36" Margin="0,0,16,0" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.ConnectedDevice.Name, Mode=OneWay, FallbackValue='Apple Device'}"
                                           Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Keep your device unlocked during scanning and transfer."
                                           Style="{StaticResource SupportingTextStyle}" FontSize="12" />
                            </StackPanel>

                            <!-- Connection Status Badge -->
                            <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.ConnectionModeText, Mode=OneWay}"
                                               FontWeight="SemiBold" FontSize="12"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Device Storage Meter -->
                        <StackPanel Spacing="6" Margin="0,4,0,0">
                            <Grid>
                                <TextBlock Text="Device Storage" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.DeviceStorageFormatted, Mode=OneWay}"
                                           HorizontalAlignment="Right" FontSize="12" FontWeight="Medium" />
                            </Grid>
                            <ProgressBar Value="{x:Bind ViewModel.DeviceStoragePercent, Mode=OneWay}"
                                         Maximum="100" Height="6" CornerRadius="3"
                                         Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Disconnected State -->
                    <StackPanel Spacing="12"
                                Visibility="{x:Bind ViewModel.IsDeviceConnected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                        <Grid RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Glyph="&#xE8EA;" FontSize="36" Margin="0,0,16,0" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Connect your iPhone" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                                <TextBlock Text="Connect via USB cable or use the Wireless tab for local Wi-Fi sync."
                                           Style="{StaticResource SupportingTextStyle}" FontSize="12" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                <Ellipse Width="8" Height="8" Fill="#8A8886" />
                                <TextBlock Text="Disconnected" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Destination Section -->
            <Border Style="{StaticResource SurfaceCardStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="Save to" Style="{ThemeResource BaseTextBlockStyle}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.DestinationFreeSpaceSummary, Mode=OneWay}"
                                   HorizontalAlignment="Right" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{x:Bind ViewModel.DestinationPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Choose a backup folder" AutomationProperties.Name="Backup folder" MinHeight="40"
                                 VerticalAlignment="Center" />

                        <Button Grid.Column="1" Click="BrowseDestinationButton_Click" VerticalAlignment="Center" MinHeight="40"
                                AutomationProperties.Name="Choose backup folder">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xED25;" FontSize="16" />
                                <TextBlock Text="Choose…" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Backup Status Card -->
            <Border Style="{StaticResource SurfaceCardStyle}">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Backup" Style="{ThemeResource BaseTextBlockStyle}" FontWeight="SemiBold" />
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="8,2">
                                <TextBlock Text="{x:Bind ViewModel.ActivityStage, Mode=OneWay}"
                                           Style="{ThemeResource CaptionTextBlockStyle}" />
                            </Border>
                        </StackPanel>

                        <!-- Scheduled Backup Countdown Pill -->
                        <Border HorizontalAlignment="Right" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8" Padding="10,3">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xED5A;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.NextScheduledBackupSummary, Mode=OneWay}"
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" AutomationProperties.LiveSetting="Polite"
                               TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- Progress Bar -->
                    <ProgressBar AutomationProperties.Name="Backup progress" Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                                 IsIndeterminate="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                                 Maximum="100" Height="6" CornerRadius="3" />

                    <!-- Detailed Metrics -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Files -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="Files" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.FilesProgress, Mode=OneWay}"
                                       Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold" />
                        </StackPanel>

                        <!-- Bytes -->
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Transferred" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.BytesProgress, Mode=OneWay}"
                                       Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold" />
                        </StackPanel>

                        <!-- Estimated Remaining -->
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="Time left" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.EstimatedTimeRemaining, Mode=OneWay}"
                                       Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. Action Buttons -->
            <StackPanel Spacing="12">
                <Button Style="{StaticResource PrimaryActionStyle}"
                        Command="{x:Bind ViewModel.StartBackupCommand}"
                        MinWidth="160" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsBackingUp, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsBackingUp, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <FontIcon Glyph="&#xE768;" FontSize="16"
                                  Visibility="{x:Bind ViewModel.IsBackingUp, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}" />
                        <TextBlock Text="{x:Bind ViewModel.StartButtonText, Mode=OneWay}" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind ViewModel.PauseResumeCommand}"
                        Visibility="{x:Bind ViewModel.IsBackingUp, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Padding="20,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE769;" FontSize="16" />
                        <TextBlock Text="{x:Bind ViewModel.PauseResumeButtonText, Mode=OneWay}" />
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind ViewModel.CancelBackupCommand}"
                        Visibility="{x:Bind ViewModel.IsBackingUp, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Padding="20,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE711;" FontSize="16" />
                        <TextBlock Text="Cancel" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 5. Last Backup Summary Line -->
            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="12" Padding="12,10">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE81C;" FontSize="16" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind ViewModel.LastBackupSummary, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 6. Support & Diagnostics Expander -->
            <Expander Header="Help &amp; diagnostics" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="10" Padding="0,8,0,4">
                    <TextBlock Text="Unlock the iPhone, tap Trust This Computer, keep the screen awake, and confirm Apple Devices or iTunes is installed."
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Spacing="8">
                        <Button Content="Open backup folder" Command="{x:Bind ViewModel.OpenDestinationCommand}" />
                        <Button Content="Open diagnostic logs" Command="{x:Bind ViewModel.OpenLogsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- 7. Automation Toggle -->
            <StackPanel Spacing="8">
                <CheckBox Content="Back up automatically when connected"
                          IsChecked="{x:Bind ViewModel.AutoBackupOnConnect, Mode=TwoWay}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
